# ============================================
# Smart Sabarmati Riverfront - Frontend Environment Variables
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values below
# 3. Never commit .env to git (already in .gitignore)
#
# ============================================

# ============================================
# BACKEND API CONFIGURATION
# ============================================
# Backend API URL
# Development: http://localhost:3000
# Production: https://api.smartriverwatch.com
# For physical device on same WiFi: http://YOUR_COMPUTER_IP:3000
#   (Find your IP: ifconfig (Linux/Mac) or ipconfig (Windows))
EXPO_PUBLIC_API_URL=http://localhost:3000

# ============================================
# FIREBASE CONFIGURATION (REQUIRED)
# ============================================
# Get these values from Firebase Console:
# 1. Go to Firebase Console: https://console.firebase.google.com/
# 2. Select your project
# 3. Go to Project Settings (gear icon) > Your apps
# 4. Select Web app or create new
# 5. Copy config values from the Firebase SDK snippet
#
# Example Firebase config:
# const firebaseConfig = {
#   apiKey: "AIza...",
#   authDomain: "your-project.firebaseapp.com",
#   projectId: "your-project-id",
#   storageBucket: "your-project.appspot.com",
#   messagingSenderId: "123456789",
#   appId: "1:123456789:web:abc123",
#   measurementId: "G-XXXXXXXXXX"
# }
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key-here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# GOOGLE MAPS API (OPTIONAL)
# ============================================
# For custom map styling and advanced map features
# Get API key from: https://console.cloud.google.com/google/maps-apis
# 
# Note: Basic maps work without API key, but some features require it
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=your-android-key
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=your-ios-key

# ============================================
# NOTES
# ============================================
# - All EXPO_PUBLIC_* variables are exposed to the client
# - Never put sensitive secrets here (use backend for secrets)
# - See frontend/README.md for detailed setup instructions
# - See backend/FIREBASE_SETUP.md for Firebase configuration
# - Never commit .env file to git (already in .gitignore)
# - After changing .env, restart Expo: npx expo start -c
