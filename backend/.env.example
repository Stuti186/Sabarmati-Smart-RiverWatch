# Environment Configuration
NODE_ENV=development
PORT=3000

# Firebase Admin SDK (Database & Authentication)
# Get your service account JSON from Firebase Console > Project Settings > Service Accounts
# Paste the entire JSON as a single line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"..."}

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:8081,exp://192.168.1.100:8081

# API Keys
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
WEATHER_API_KEY=your-weather-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# IoT/Sensor Integration
IOT_MQTT_BROKER=mqtt://localhost:1883
IOT_MQTT_USERNAME=
IOT_MQTT_PASSWORD=

# Alert Thresholds
ALERT_PH_MIN=6.5
ALERT_PH_MAX=8.5
ALERT_DO_MIN=4.0
ALERT_BOD_MAX=5.0
ALERT_TURBIDITY_MAX=5.0
ALERT_TEMPERATURE_MAX=30.0

# Cleanup Schedules
CLEANUP_OLD_REPORTS_DAYS=90
CLEANUP_OLD_ALERTS_DAYS=30
