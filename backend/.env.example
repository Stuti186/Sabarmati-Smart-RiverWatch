# ============================================
# Smart Sabarmati Riverfront - Backend Environment Variables
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values below
# 3. Never commit .env to git (already in .gitignore)
#
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# FIREBASE CONFIGURATION (REQUIRED)
# ============================================
# Get service account JSON from:
# 1. Go to Firebase Console: https://console.firebase.google.com/
# 2. Select your project
# 3. Go to Project Settings > Service Accounts
# 4. Click "Generate new private key"
# 5. Download JSON file
# 6. Convert entire JSON to single-line string (escape newlines as \\n)
# 7. Wrap in single quotes
#
# Example format:
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com",...}'
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate a secure random string for production
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
# Add your frontend URLs here
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000

# ============================================
# APPLICATION CONFIGURATION
# ============================================
CLEANUP_OLD_REPORTS_DAYS=90
CLEANUP_OLD_ALERTS_DAYS=30
API_BASE_URL=http://localhost:3000

# ============================================
# GOOGLE GEMINI AI (OPTIONAL - for AI Species Identification)
# ============================================
# Get API key from:
# 1. Visit: https://aistudio.google.com/app/apikey
# 2. Sign in with Google account
# 3. Click "Create API Key"
# 4. Copy the API key
#
# Free tier: 15 requests/minute, 1,500 requests/day
# Leave empty if not using AI species identification
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# AI DROWNING DETECTION (OPTIONAL)
# ============================================
# Set to 'true' for testing (increases detection probability to 10%)
# Set to 'false' for production (very low detection rate)
ENABLE_TEST_DETECTIONS=false

# ============================================
# CCTV CAMERA RTSP URLs (OPTIONAL - for production)
# ============================================
# Uncomment and add your camera RTSP URLs when ready
# CAMERA_001_RTSP=rtsp://camera1.sabarmati.local:554/stream
# CAMERA_002_RTSP=rtsp://camera2.sabarmati.local:554/stream
# CAMERA_003_RTSP=rtsp://camera3.sabarmati.local:554/stream
# CAMERA_004_RTSP=rtsp://camera4.sabarmati.local:554/stream
# CAMERA_005_RTSP=rtsp://camera5.sabarmati.local:554/stream

# ============================================
# NOTES
# ============================================
# - FIREBASE_SERVICE_ACCOUNT must be a single-line JSON string
# - Escape newlines in private key as \\n
# - Wrap entire JSON in single quotes
# - See backend/FIREBASE_SETUP.md for detailed Firebase setup
# - See GOOGLE_GEMINI_SETUP.md for Gemini AI setup
# - Never commit .env file to git (already in .gitignore)
