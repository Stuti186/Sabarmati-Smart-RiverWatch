# Production environment template (no secrets committed)

# Server
PORT=3000
# Comma-separated origins (add your web/app origins)
CORS_ORIGIN=https://your-frontend.example.com

# Auth / Secrets
JWT_SECRET=

# Firebase (service account path or JSON string)
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# Google Gemini (LLM)
GOOGLE_GEMINI_API_KEY=

# Optional
LOG_LEVEL=info
ENABLE_TEST_DETECTIONS=false

